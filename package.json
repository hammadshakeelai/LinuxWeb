{
  "name": "linuxweb",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/prepare-public.ts",
    "dev": "vite",
    "prebuild": "node scripts/prepare-public.ts",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/copy-image.ts",
    "readme-images": "node scripts/readme-images.ts",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "oxlint --deny-warnings src scripts image e2e relay",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "image": "bash image/build.sh",
    "image:test": "node image/test-image.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "v86": "0.5.458"
  },
  "devDependencies": {
    "@mercuryworkshop/wisp-js": "0.5.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
